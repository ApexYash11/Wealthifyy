# Frontend Environment Configuration

# API Configuration
# Local Development
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Railway Backend)
NEXT_PUBLIC_API_URL=https://wealthify-production.up.railway.app

# Supabase Configuration (Get these from your Supabase Project Settings)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# NextAuth / Auth Configuration
# Local
# NEXTAUTH_URL=http://localhost:3000
# Production (Vercel)
NEXTAUTH_URL=https://wealthifyy-beta.vercel.app
